
@page "/profiles"
@rendermode InteractiveServer

@using CampusChat.Models
@using CampusChat.Services

@inject ProfileService ProfileService
@inject UserStateService UserState
@inject UserService UserService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage SessionStorage

<PageTitle>Student Profiles - CampusChat</PageTitle>

<div class="container-fluid px-0">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
        <div>
            <h2 class="fw-bold mb-2">Student Profiles</h2>

            <p class="text-muted mb-0">
                Meet the students in CampusChat.
                Select a profile to view more information.
            </p>
        </div>

        <button class="btn btn-primary"
                @onclick="ToggleCreateForm">
            @(showCreateForm ? "Cancel" : "Create Profile")
        </button>
    </div>

    @if (showCreateForm)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">

                <h4 class="fw-bold mb-3">Create Student Profile</h4>

                <div class="mb-3">
                    <label class="form-label">Display Name</label>

                    <input class="form-control"
                           maxlength="60"
                           placeholder="Enter student name"
                           @bind="newDisplayName" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Bio</label>

                    <textarea class="form-control"
                              rows="3"
                              maxlength="500"
                              placeholder="Write something about yourself"
                              @bind="newBio"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Study Year</label>

                    <input type="number"
                           class="form-control"
                           min="1"
                           max="6"
                           @bind="newStudyYear" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Avatar Color</label>

                    <input type="color"
                           class="form-control form-control-color"
                           @bind="newAvatarColor" />
                </div>

                <button class="btn btn-primary me-2"
                        @onclick="CreateProfile">
                    Save Profile
                </button>

                <button class="btn btn-outline-secondary"
                        @onclick="ToggleCreateForm">
                    Cancel
                </button>

            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @(actionSuccessful ? "alert-success" : "alert-warning") mb-4">
            @message
        </div>
    }

    @if (!studentLoaded)
    {
        <p>Loading student profiles...</p>
    }
    else
    {
        <div class="row g-4">

            @foreach (var student in ProfileService.GetProfiles())
            {
                <div class="col-md-6 col-lg-4" @key="student.Id">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4">

                            <div class="d-flex align-items-center gap-3 mb-3">

                                <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold"
                                     style="background-color: @student.AvatarColor; width: 55px; height: 55px; font-size: 24px;">
                                    @GetInitial(student.DisplayName)
                                </div>

                                <div>
                                    <h5 class="fw-bold mb-1">
                                        @student.DisplayName
                                    </h5>

                                    <span class="text-muted small">
                                        Study Year @student.StudyYear
                                    </span>
                                </div>

                            </div>

                            <p class="text-muted">
                                @student.Bio
                            </p>

                            @if (student.IsAuditor)
                            {
                                <span class="badge bg-info text-dark mb-3">
                                    Auditor
                                </span>
                            }

                            <p class="small text-muted">
                                Joined threads:
                                @ProfileService.GetJoinedThreads(student.Id).Count
                            </p>

                            <a class="btn btn-outline-primary w-100"
                               href="@($"/profiles/{student.Id}")">
                                View Profile
                            </a>

                        </div>
                    </div>
                </div>
            }

        </div>
    }
</div>

@code {
    private bool studentLoaded;
    private bool showCreateForm;
    private bool actionSuccessful;

    private string newDisplayName = "";
    private string newBio = "";
    private int newStudyYear = 1;
    private string newAvatarColor = "#4F46E5";

    private string message = "";

    /// <summary>
    /// Shows or hides the profile creation form.
    /// </summary>
    private void ToggleCreateForm()
    {
        showCreateForm = !showCreateForm;
        message = "";
        actionSuccessful = false;
    }

    /// <summary>
    /// Creates a student profile through ProfileService.
    /// </summary>
    private void CreateProfile()
    {
        actionSuccessful = false;
        message = "";

        User? createdUser = ProfileService.CreateProfile(
            newDisplayName,
            newBio,
            newStudyYear,
            newAvatarColor
        );

        if (createdUser == null)
        {
            message = "Could not create profile. Check the name, study year, and avatar color. The name must also be unique.";
            return;
        }

        actionSuccessful = true;
        message = $"Profile for {createdUser.DisplayName} created successfully! You can now select this student on the Login page.";

        newDisplayName = "";
        newBio = "";
        newStudyYear = 1;
        newAvatarColor = "#4F46E5";

        showCreateForm = false;
    }

    /// <summary>
    /// Returns the first letter of a student's display name.
    /// </summary>
    private string GetInitial(string displayName)
    {
        if (string.IsNullOrWhiteSpace(displayName))
        {
            return "?";
        }

        return displayName.Trim()[0].ToString().ToUpper();
    }

    /// <summary>
    /// Restores the selected student after a page refresh.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var result = await SessionStorage.GetAsync<int>(
                "SelectedStudentId"
            );

            if (result.Success &&
                UserService.GetUserById(result.Value) != null)
            {
                UserState.SetCurrentUser(result.Value);
            }
        }
        catch (Exception)
        {
            // Profiles can still be viewed without a selected student.
        }
        finally
        {
            studentLoaded = true;
            await InvokeAsync(StateHasChanged);
        }
    }
}
