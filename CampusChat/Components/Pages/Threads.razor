@page "/threads"
@rendermode InteractiveServer
@using CampusChat.Services
@inject ThreadService ThreadService
@inject UserStateService UserState

<h1>Discussion Threads</h1>

<p>Welcome to the CampusChat discussion threads.</p>

<h3>Create a Thread</h3>

<div class="mb-3">
    <label class="form-label">Thread Name</label>
    <input class="form-control" @bind="threadName" />
</div>

<div class="mb-3">
    <label class="form-label">Description</label>
    <textarea class="form-control" @bind="threadDescription"></textarea>
</div>
<button class="btn btn-primary" @onclick="CreateThread">
    Create Thread
</button>

<h3>Available Threads</h3>

@if (!ThreadService.GetAllThreads().Any())
{
    <p>No discussion threads available yet.</p>
}

@foreach (var thread in ThreadService.GetAllThreads())
{
    <div class="card mb-3">
        <div class="card-body">
            <h4>@thread.Name</h4>
            <p>@thread.Description</p>
            <p>@(thread.IsPrivate ? "Private" : "Public")</p>
        </div>
    </div>
}

@code {
    private string threadName = "";
    private string threadDescription = "";

    private void CreateThread()
    {
        // We will connect this to ThreadService.CreateThread().
    }
}

  
}