
@page "/direct-chats"
@rendermode InteractiveServer

@using CampusChat.Models
@using CampusChat.Services

@inject DirectChatService DirectChatService
@inject UserService UserService
@inject UserStateService UserState
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage SessionStorage

<PageTitle>Direct Chats - CampusChat</PageTitle>

<div class="container-fluid px-0">

    <h2 class="fw-bold mb-2">Direct Chats</h2>

    <p class="text-muted mb-4">
        Send private messages to other students.
        Only conversation participants can send messages.
    </p>

    @if (!studentLoaded)
    {
        <p>Loading student selection...</p>
    }
    else if (UserState.CurrentUserId == null)
    {
        <div class="alert alert-warning">
            Please <a href="/login">select a student</a>
            before using Direct Chats.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">

                <h4 class="fw-bold mb-3">Start a Conversation</h4>

                <label class="form-label">Choose a Student</label>

                <select class="form-select mb-3"
                        @bind="selectedStudentId">

                    <option value="0">Select a student...</option>

                    @foreach (var student in GetOtherStudents())
                    {
                        <option value="@student.Id">
                            @student.DisplayName
                        </option>
                    }

                </select>

                <button class="btn btn-primary"
                        disabled="@(selectedStudentId == 0)"
                        @onclick="StartConversation">
                    Start Chat
                </button>

            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="alert @(actionSuccessful ? "alert-success" : "alert-warning") mb-4">
                @message
            </div>
        }

        @if (IsAuditor())
        {
            <div class="alert alert-info mb-4">
                <strong>Auditor access:</strong>
                You can read all direct chats.
                You can only send messages in conversations
                where you are a participant.
            </div>
        }

        <h3 class="fw-bold mb-3">
            @(IsAuditor() ? "All Conversations" : "My Conversations")
        </h3>

        @if (!GetVisibleChats().Any())
        {
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 text-muted">
                    No conversations yet.
                    Choose a student above to start a chat.
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">

                @foreach (var chat in GetVisibleChats())
                {
                    <div class="col-md-6 col-lg-4" @key="chat.Id">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body p-4">

                                <h5 class="fw-bold mb-2">
                                    @GetStudentName(chat.User1Id)
                                    ↔
                                    @GetStudentName(chat.User2Id)
                                </h5>

                                <p class="text-muted small mb-2">
                                    Created:
                                    @chat.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                </p>

                                <p class="text-muted small mb-3">
                                    @DirectChatService.GetMessages(
                                        chat.Id,
                                        UserState.CurrentUserId.Value
                                    ).Count messages
                                </p>

                                @if (IsParticipant(chat))
                                {
                                    <span class="badge bg-success mb-3">
                                        Participant
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark mb-3">
                                        Auditor - Read Only
                                    </span>
                                }

                                <div>
                                    <a class="btn btn-outline-primary w-100"
                                       href="@($"/direct-chats/{chat.Id}")">
                                        Open Chat
                                    </a>
                                </div>

                            </div>
                        </div>
                    </div>
                }

            </div>
        }
    }
</div>

@code {
    private bool studentLoaded;
    private bool actionSuccessful;

    private int selectedStudentId;
    private string message = "";

    /// <summary>
    /// Returns students other than the currently selected student.
    /// </summary>
    private List<User> GetOtherStudents()
    {
        if (UserState.CurrentUserId == null)
        {
            return new List<User>();
        }

        return UserService.GetAllUsers()
            .Where(user => user.Id != UserState.CurrentUserId.Value)
            .ToList();
    }

    /// <summary>
    /// Returns the student's display name.
    /// </summary>
    private string GetStudentName(int userId)
    {
        return UserService.GetUserById(userId)?.DisplayName
               ?? "Unknown Student";
    }

    /// <summary>
    /// Checks whether the selected student is an auditor.
    /// </summary>
    private bool IsAuditor()
    {
        if (UserState.CurrentUserId == null)
        {
            return false;
        }

        return UserService.GetUserById(
            UserState.CurrentUserId.Value
        )?.IsAuditor == true;
    }

    /// <summary>
    /// Checks whether the selected student belongs to a conversation.
    /// </summary>
    private bool IsParticipant(DirectChat chat)
    {
        if (UserState.CurrentUserId == null)
        {
            return false;
        }

        int userId = UserState.CurrentUserId.Value;

        return chat.User1Id == userId ||
               chat.User2Id == userId;
    }

    /// <summary>
    /// Returns conversations visible to the selected student.
    /// </summary>
    private List<DirectChat> GetVisibleChats()
    {
        if (UserState.CurrentUserId == null)
        {
            return new List<DirectChat>();
        }

        return DirectChatService.GetVisibleChats(
            UserState.CurrentUserId.Value
        );
    }

    /// <summary>
    /// Starts a conversation with another student.
    /// </summary>
    private void StartConversation()
    {
        actionSuccessful = false;
        message = "";

        if (UserState.CurrentUserId == null ||
            selectedStudentId == 0)
        {
            message = "Please choose a student first.";
            return;
        }

        var chat = DirectChatService.CreateChat(
            UserState.CurrentUserId.Value,
            selectedStudentId
        );

        if (chat == null)
        {
            message = "Could not start the conversation.";
            return;
        }

        actionSuccessful = true;
        message = "Conversation created successfully! Click Open Chat below to start messaging.";

        selectedStudentId = 0;
    }

    /// <summary>
    /// Restores the selected student after a browser refresh.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var result = await SessionStorage.GetAsync<int>(
                "SelectedStudentId"
            );

            if (result.Success &&
                UserService.GetUserById(result.Value) != null)
            {
                UserState.SetCurrentUser(result.Value);
            }
        }
        catch (Exception)
        {
            message = "Could not restore student selection.";
        }
        finally
        {
            studentLoaded = true;
            await InvokeAsync(StateHasChanged);
        }
    }
}
