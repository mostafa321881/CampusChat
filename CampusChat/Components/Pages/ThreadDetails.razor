
@page "/threads/{ThreadId:int}"
@rendermode InteractiveServer

@using CampusChat.Services
@using CampusChat.Models

@inject ThreadService ThreadService
@inject PostService PostService
@inject UserService UserService
@inject UserStateService UserState
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage SessionStorage

<PageTitle>Thread Details - CampusChat</PageTitle>

<div class="container-fluid px-0">

    <a href="/threads" class="btn btn-outline-secondary mb-4">
        Back to Threads
    </a>

    @if (currentThread == null)
    {
        <div class="alert alert-warning">
            Thread not found.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">

                <h2 class="fw-bold">@currentThread.Name</h2>

                <p class="text-muted">
                    @currentThread.Description
                </p>

                <span class="badge @(currentThread.IsPrivate ? "bg-secondary" : "bg-success")">
                    @(currentThread.IsPrivate ? "Private" : "Public")
                </span>

                <span class="text-muted small ms-2">
                    @currentThread.MemberUserIds.Count members
                </span>

            </div>
        </div>

        @if (!studentLoaded)
        {
            <p>Loading student selection...</p>
        }
        else if (UserState.CurrentUserId == null)
        {
            <div class="alert alert-warning">
                Please <a href="/login">select a student</a>
                to participate.
            </div>
        }
        else
        {
            @if (!IsMember())
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">

                        @if (currentThread.IsPrivate && !IsAuditor())
                        {
                            <h4 class="fw-bold">Join Private Thread</h4>

                            <p class="text-muted">
                                Enter the correct secret code to join
                                and read this discussion.
                            </p>

                            <label class="form-label">
                                Secret Code
                            </label>

                            <input type="password"
                                   class="form-control mb-3"
                                   placeholder="Enter the thread secret code"
                                   autocomplete="off"
                                   @bind="joinAccessCode" />

                            <button class="btn btn-primary"
                                    @onclick="JoinThread">
                                Join Private Thread
                            </button>
                        }
                        else if (currentThread.IsPrivate && IsAuditor())
                        {
                            <h4 class="fw-bold">Auditor Access</h4>

                            <p class="text-muted">
                                You can read this private discussion
                                without entering its secret code.
                                Join the thread if you want to write posts.
                            </p>

                            <button class="btn btn-primary"
                                    @onclick="JoinThread">
                                Join Thread
                            </button>
                        }
                        else
                        {
                            <h4 class="fw-bold">Join This Thread</h4>

                            <p class="text-muted">
                                This thread is public.
                                You can read its posts without joining.
                                Join to add it to My Threads.
                            </p>

                            <button class="btn btn-primary"
                                    @onclick="JoinThread">
                                Join Thread
                            </button>
                        }

                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(joinMessage))
            {
                <div class="alert @(joinSuccessful ? "alert-success" : "alert-warning") mb-4">
                    @joinMessage
                </div>
            }

            @if (!CanViewThread())
            {
                <div class="alert alert-warning">
                    This is a private thread.
                    Enter the correct secret code to read its posts.
                </div>
            }
            else
            {
                @if (IsAuditor() &&
                     currentThread.IsPrivate &&
                     !IsMember())
                {
                    <div class="alert alert-info">
                        Auditor read-only access is active.
                        Join this thread to write posts or replies.
                    </div>
                }

                @if (CanWriteThread())
                {
                    <div class="card border-0 shadow-sm rounded-4 mb-4">
                        <div class="card-body p-4">

                            <h4>Write a Post</h4>

                            <textarea class="form-control mb-3"
                                      rows="3"
                                      placeholder="Write your message..."
                                      @bind="newPostContent"></textarea>

                            <button class="btn btn-primary"
                                    @onclick="AddPost">
                                Post Message
                            </button>

                            @if (!string.IsNullOrEmpty(message))
                            {
                                <p class="mt-3">@message</p>
                            }

                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-secondary">
                        Join this private thread to write posts and replies.
                    </div>
                }

                <h3 class="fw-bold mb-3">Discussion</h3>

                @if (!GetVisiblePosts().Any())
                {
                    <p class="text-muted">
                        No posts yet. Start the discussion!
                    </p>
                }
                else
                {
                    @foreach (var post in GetVisiblePosts())
                    {
                        <div class="card mb-3">
                            <div class="card-body">

                                <div class="d-flex justify-content-between gap-3">
                                    <strong>
                                        @UserService.GetUserById(post.AuthorUserId)?.DisplayName
                                    </strong>

                                    <small class="text-muted">
                                        @post.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                    </small>
                                </div>

                                <p class="mt-3">@post.Content</p>

                                @if (post.ParentPostId != null)
                                {
                                    <span class="badge bg-light text-dark">
                                        Reply to post #@post.ParentPostId
                                    </span>
                                }

                                <div class="mt-3">

                                    @if (CanWriteThread())
                                    {
                                        <button class="btn btn-sm btn-outline-primary me-2"
                                                @onclick="() => StartReply(post.Id)">
                                            Reply
                                        </button>
                                    }

                                    @if (post.AuthorUserId == UserState.CurrentUserId &&
                                         CanWriteThread())
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => DeletePost(post.Id)">
                                            Delete
                                        </button>
                                    }

                                </div>

                            </div>
                        </div>
                    }
                }

                @if (replyToPostId != null && CanWriteThread())
                {
                    <div class="card mt-4">
                        <div class="card-body">

                            <h5>Reply to post #@replyToPostId</h5>

                            <textarea class="form-control mb-3"
                                      rows="2"
                                      @bind="replyContent"></textarea>

                            <button class="btn btn-primary me-2"
                                    @onclick="SubmitReply">
                                Send Reply
                            </button>

                            <button class="btn btn-outline-secondary"
                                    @onclick="CancelReply">
                                Cancel
                            </button>

                        </div>
                    </div>
                }
            }
        }
    }
</div>

@code {
    [Parameter]
    public int ThreadId { get; set; }

    private CampusChat.Models.Thread? currentThread;

    private string newPostContent = "";
    private string replyContent = "";
    private string joinAccessCode = "";
    private string joinMessage = "";
    private string message = "";

    private int? replyToPostId;
    private bool studentLoaded;
    private bool joinSuccessful;

    protected override void OnParametersSet()
    {
        currentThread = ThreadService.GetThreadById(ThreadId);

        message = "";
        joinMessage = "";
        joinAccessCode = "";
        replyToPostId = null;
        joinSuccessful = false;
    }

    /// <summary>
    /// Checks whether the selected user is an auditor.
    /// </summary>
    private bool IsAuditor()
    {
        if (UserState.CurrentUserId == null)
        {
            return false;
        }

        return UserService
            .GetUserById(UserState.CurrentUserId.Value)?
            .IsAuditor == true;
    }

    /// <summary>
    /// Checks whether the student has joined the thread.
    /// </summary>
    private bool IsMember()
    {
        if (currentThread == null ||
            UserState.CurrentUserId == null)
        {
            return false;
        }

        return currentThread.MemberUserIds.Contains(
            UserState.CurrentUserId.Value
        );
    }

    /// <summary>
    /// Checks whether the student can read the thread.
    /// Auditors can read private threads without joining.
    /// </summary>
    private bool CanViewThread()
    {
        if (currentThread == null ||
            UserState.CurrentUserId == null)
        {
            return false;
        }

        return ThreadService.CanReadThread(
            ThreadId,
            UserState.CurrentUserId.Value
        );
    }

    /// <summary>
    /// Checks whether the student can write in the thread.
    /// Private threads require membership, including for auditors.
    /// </summary>
    private bool CanWriteThread()
    {
        if (currentThread == null ||
            UserState.CurrentUserId == null)
        {
            return false;
        }

        return !currentThread.IsPrivate || IsMember();
    }

    /// <summary>
    /// Returns only posts the selected user is allowed to read.
    /// </summary>
    private List<Post> GetVisiblePosts()
    {
        if (UserState.CurrentUserId == null ||
            !CanViewThread())
        {
            return new List<Post>();
        }

        return PostService.GetPostsByThread(
            ThreadId,
            UserState.CurrentUserId.Value
        );
    }

    /// <summary>
    /// Joins a public or private thread.
    /// Private threads require a code, except for auditors.
    /// </summary>
    private void JoinThread()
    {
        joinSuccessful = false;
        joinMessage = "";

        if (UserState.CurrentUserId == null ||
            currentThread == null)
        {
            joinMessage = "Please select a student first.";
            return;
        }

        bool joined = ThreadService.JoinThread(
            ThreadId,
            UserState.CurrentUserId.Value,
            joinAccessCode
        );

        if (joined)
        {
            joinSuccessful = true;
            joinMessage = "You joined the thread successfully! It will now appear in My Threads.";
            joinAccessCode = "";
        }
        else
        {
            joinMessage = currentThread.IsPrivate && !IsAuditor()
                ? "Incorrect secret code. Please try again."
                : "Could not join the thread.";
        }
    }

    /// <summary>
    /// Creates a new post.
    /// </summary>
    private void AddPost()
    {
        if (UserState.CurrentUserId == null ||
            !CanWriteThread())
        {
            message = "You do not have permission to post here.";
            return;
        }

        var post = PostService.CreatePost(
            ThreadId,
            UserState.CurrentUserId.Value,
            newPostContent
        );

        if (post == null)
        {
            message = "Could not create post. Please enter a message.";
            return;
        }

        newPostContent = "";
        message = "Post created successfully!";
    }

    /// <summary>
    /// Starts replying to a post.
    /// </summary>
    private void StartReply(int postId)
    {
        if (!CanWriteThread())
        {
            return;
        }

        replyToPostId = postId;
        replyContent = "";
    }

    /// <summary>
    /// Creates a reply to another post.
    /// </summary>
    private void SubmitReply()
    {
        if (UserState.CurrentUserId == null ||
            replyToPostId == null ||
            !CanWriteThread())
        {
            return;
        }

        var reply = PostService.CreatePost(
            ThreadId,
            UserState.CurrentUserId.Value,
            replyContent,
            replyToPostId
        );

        if (reply == null)
        {
            message = "Could not send reply. Please enter a message.";
            return;
        }

        replyContent = "";
        replyToPostId = null;
        message = "Reply sent successfully!";
    }

    /// <summary>
    /// Deletes a post only if the selected user wrote it.
    /// </summary>
    private void DeletePost(int postId)
    {
        if (UserState.CurrentUserId == null ||
            !CanWriteThread())
        {
            return;
        }

        bool deleted = PostService.DeletePost(
            postId,
            UserState.CurrentUserId.Value
        );

        message = deleted
            ? "Post deleted successfully!"
            : "You can only delete your own posts.";
    }

    /// <summary>
    /// Cancels replying.
    /// </summary>
    private void CancelReply()
    {
        replyToPostId = null;
        replyContent = "";
    }

    /// <summary>
    /// Restores the selected student after refreshing the page.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var result = await SessionStorage.GetAsync<int>(
                "SelectedStudentId"
            );

            if (result.Success &&
                UserService.GetUserById(result.Value) != null)
            {
                UserState.SetCurrentUser(result.Value);
            }
        }
        catch (Exception)
        {
            message = "Could not restore student selection.";
        }
        finally
        {
            studentLoaded = true;
            await InvokeAsync(StateHasChanged);
        }
    }
}
